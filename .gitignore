# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/firebase.handover-v2-emulator.generated.json
/firebase.handover-v2-report-emulator.generated.json
/firebase.handover-v2-confirmation-emulator.generated.json
/firebase.uat-emulator.generated.json
/firebase.uat-09m-emulator.generated.json
/firebase.recovery-approval-v2-8c4b.generated.json
/firebase.recovery-approval-v2-http.generated.json

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
auth-debug.log*
ui-debug.log*

# env files (can opt-in for committing if needed)
.env*
.demo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloud functions (delivery backend) build artifacts + local deps
/functions/node_modules/
/functions/lib/

# service-account / FCM credentials must never be committed
*.serviceAccount*.json
service-account*.json
firebase-service-account*.json
