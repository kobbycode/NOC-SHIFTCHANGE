{
  "name": "shiftchange-v2-functions",
  "description": "TECH-HO-RECOVERY-09L — Cloud Functions (2nd gen) notification delivery backend. Drains the Firestore transactional outbox and pushes via a transport seam (mock locally, real FCM in staging/production).",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=lib/index.js --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/* --alias:server-only=./empty-server-only.js --alias:@=../src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  }
}
